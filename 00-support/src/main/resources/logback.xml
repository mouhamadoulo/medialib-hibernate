<?xml version="1.0" encoding="UTF-8"?>
<!--
  Les tests de ce depot n'assertionnent pas sur les logs : ils assertionnent sur le compteur
  SQL. On garde donc la sortie silencieuse. Pour voir le SQL pendant une mise au point, passer
  org.hibernate.SQL en DEBUG.
-->
<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <charset>UTF-8</charset>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="org.hibernate" level="WARN"/>
    <logger name="org.testcontainers" level="WARN"/>
    <logger name="com.github.dockerjava" level="WARN"/>
    <logger name="tc" level="WARN"/>

    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
